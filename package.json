{
  "name": "dadida",
  "version": "0.2.0",
  "description": "Build AI personas for Discord community engagement & management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discord": {
      "types": "./dist/platforms/discord.d.ts",
      "import": "./dist/platforms/discord.js"
    }
  },
  "bin": {
    "dadida": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js start"
  },
  "keywords": [
    "discord",
    "ai",
    "bot",
    "agents",
    "community",
    "framework"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiwhiteteam/dadida.git"
  },
  "homepage": "https://github.com/aiwhiteteam/dadida#readme",
  "bugs": {
    "url": "https://github.com/aiwhiteteam/dadida/issues"
  },
  "dependencies": {
    "@openai/agents": "^0.11.0",
    "better-sqlite3": "^11.0.0",
    "discord.js": "^14.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ]
}
